{
  "manifest_version": 3,
  "name": "Crunchy Watchlist Curator",
  "version": "0.1.0",
  "description": "Adds watch-ready filtering and rating-based sorting helpers to Crunchyroll watchlists.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.crunchyroll.com/watchlist*",
    "https://www.crunchyroll.com/*/watchlist*",
    "https://www.crunchyroll.com/auth/v1/token",
    "https://www.crunchyroll.com/content/v2/*",
    "https://www.crunchyroll.com/content-reviews/v3/rating/series/*",
    "https://www.crunchyroll.com/series/*"
  ],
  "action": {
    "default_title": "Crunchy Watchlist Curator",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "64": "icons/icon-64.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png",
      "256": "icons/icon-256.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "1024": "icons/icon-1024.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.crunchyroll.com/*"],
      "js": [
        "src/runtime/runtime-store.js",
        "src/runtime/bootstrap-gate.js",
        "src/runtime/runtime-trace.js",
        "src/runtime/state-loader.js",
        "src/runtime/route-lifecycle.js",
        "src/runtime/preferred-audio-detector.js",
        "src/runtime/curated-renderable.js",
        "src/runtime/curated-panel.js",
        "src/runtime/curated-loader.js",
        "src/runtime/native-bridge.js",
        "src/runtime/curated-interactions.js",
        "src/runtime/interface-shell.js",
        "src/runtime/debug-api.js",
        "src/runtime/bootstrap-config.js",
        "src/runtime/bootstrap-modules.js",
        "src/runtime/bootstrap-helpers.js",
        "src/data/storage-adapter.js",
        "src/data/api-contracts.js",
        "src/data/auth-client.js",
        "src/data/watchlist-client.js",
        "src/data/watchlist-repository.js",
        "src/data/history-repository-cache.js",
        "src/data/history-repository-preload.js",
        "src/data/history-repository.js",
        "src/data/ratings-client.js",
        "src/data/ratings-repository.js",
        "src/data/preview-repository.js",
        "src/domain/core-primitives.js",
        "src/domain/image-variants.js",
        "src/domain/entry-normalizer.js",
        "src/domain/sort-metrics.js",
        "src/domain/entry-sorting.js",
        "src/ui/card-metadata.js",
        "src/ui/controls-view.js",
        "src/ui/curated-card-view.js",
        "src/ui/curated-card-shell.js",
        "content.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}

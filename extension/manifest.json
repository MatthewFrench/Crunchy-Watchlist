{
  "manifest_version": 3,
  "name": "Crunchy Watchlist Curator",
  "version": "0.1.0",
  "description": "Adds actionable filtering and rating-based sorting helpers to Crunchyroll watchlists.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.crunchyroll.com/*"],
  "action": {
    "default_title": "Crunchy Watchlist Curator"
  },
  "content_scripts": [
    {
      "matches": ["https://www.crunchyroll.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
